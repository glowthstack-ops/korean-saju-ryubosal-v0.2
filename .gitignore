# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual env
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Astronomy ephemeris (downloaded on demand by the generation script)
*.bsp

# OS / editor
.DS_Store
.idea/
.vscode/

# Local environment (DB 접속 등 — .env.example만 추적)
.env

# Intent 분류기 ONNX 모델(110MB) — git 미추적. scripts/build_intent_onnx.py로 재생성, .sha256으로 무결성 검증.
backend/compiled/intent_onnx/*.onnx

# Shadow Validation Harness 산출물(재생성 가능 — 커밋 금지)
backend/data/shadow_reports/*.csv
backend/data/shadow_reports/*.json

# Shadow 차트 탐색 로그(대용량·재생성) — coverage_report.json·charts.jsonl 은 추적
backend/data/shadow_charts/search_logs/

# Region GIS P0 패키지(doc/gis) — 계산용 대용량 원천. 런타임은 compiled 스냅샷을 쓰고,
# 재빌드는 scripts/build_region_profiles.py(원천 재배치 시 graceful). 소형 메타·검증·스키마는 추적.
doc/gis/*.sqlite
doc/gis/*.csv.gz
doc/gis/region_units_compact_*.jsonl
doc/gis/region_units_compact_*.csv
