# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual env
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Astronomy ephemeris (downloaded on demand by the generation script)
*.bsp

# OS / editor
.DS_Store
.idea/
.vscode/

# Local environment (DB 접속 등 — .env.example만 추적)
.env

# Intent 분류기 ONNX 모델(110MB) — git 미추적. scripts/build_intent_onnx.py로 재생성, .sha256으로 무결성 검증.
backend/compiled/intent_onnx/*.onnx

# Shadow Validation Harness 산출물(재생성 가능 — 커밋 금지)
backend/data/shadow_reports/*.csv
backend/data/shadow_reports/*.json

# Shadow 차트 탐색 로그(대용량·재생성) — coverage_report.json·charts.jsonl 은 추적
backend/data/shadow_charts/search_logs/

# Region GIS P0 패키지(doc/gis) — 계산용 대용량 원천. 런타임은 compiled 스냅샷을 쓰고,
# 재빌드는 scripts/build_region_profiles.py(원천 재배치 시 graceful). 소형 메타·검증·스키마는 추적.
doc/gis/*.sqlite
doc/gis/*.csv.gz
doc/gis/region_units_compact_*.jsonl
doc/gis/region_units_compact_*.csv
# 외부 지형 feature 대표좌표(P4-Data, doc/gis_region 툴킷 산출) — 대용량. 엔진은 compiled 요약 사용.
doc/gis/external_geo_features*.csv
doc/gis/external_geo_features*.sqlite
# 지역 엔진 감사 산출물(재생성 가능 — 커밋 금지). 운영 스냅샷(profiles/admin/directional)은 추적.
backend/compiled/region_weights_review.*
backend/compiled/external_geo_acceptance_report.*
# P4-SearchSeed 생성 산출물(검색 기반 부트스트랩 — 재생성 가능·검수 전). 스크립트/코어는 추적.
doc/gis/search_seed/
# Tier B 지형 원천(무로그인 재다운로드 가능 — OSM 544MB·Copernicus DEM·Natural Earth) + geo 신호
# 산출물(재생성 가능, geo 가중 보정·전문가 감수 전이라 미활성). 빌드 스크립트(scripts/)는 추적.
doc/gis/_geo_src/
doc/gis/region_geo_features.jsonl
# 방향성 지형 요약(31MB, 재생성: extract_osm_geo_features→build_region_directional_summary).
# 런타임 graceful(부재 시 directional_terrain.available=false). 소형 compiled(profiles/admin)은 추적.
backend/compiled/region_directional_summary_v1.json

# 위험 adapter 전역 suspension 상태(런타임 공유 파일 — 감수 53차, git 미추적)
backend/compiled/risk_adapter_suspensions.json

# 위험 adapter 런타임 상태 디렉터리(감수 54차 — git 미추적)
backend/var/
