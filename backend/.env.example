# saju_v2 백엔드 환경 변수 예시 — 실제 값은 .env(미추적)에 둔다.
# v1 DB(5432)와 분리된 전용 인스턴스(docker-compose.yml: saju-v2-db, 호스트 5433).
SAJU_V2_DATABASE_URL=postgresql://saju_v2:saju_v2@localhost:5433/saju_v2

# LLM 키(루트 ../.env에서 자동 로드됨 — backend/config/llm_config.json에서 모델·폴백 관리)
# GEMINI_API_KEY=...   # 메인(gemini-3-flash-preview)
# OPENAI_API_KEY=...   # 비상 폴백(gpt-5-mini)

# ── 위험 노출 canary 활성화(r4.1.0-canary — 운영 preflight 후에만 설정) ──
# 순서(통합 감수 §5): HMAC 운영 키 → topology+실제 worker=1 확인 →
# allowlist → 태그 배포 → runtime enabled → mode. 미설정=전부 잠금(off).
# RISK_AUDIT_HMAC_KEY_B64=   # base64, decode 후 32바이트 이상(환경별 상이)
# RISK_DEPLOYMENT_TOPOLOGY=single_host_single_process
# RISK_EXPOSE_CANARY_SUBJECT_IDS=   # 내부 인증 subject ID, 콤마 구분(소수)
# RISK_EXPOSURE_RUNTIME_ENABLED=true
# RISK_ENGINE_MODE=expose_canary
# 활성화 직후: python scripts/risk_canary_smoke.py 로 §9 점검 →
# 내부 계정 1건 smoke 요청. 중단: RISK_ENGINE_MODE=off (byte 복귀 fixture 有)
