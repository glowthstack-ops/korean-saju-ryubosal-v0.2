# saju_v2 백엔드 환경 변수 예시 — 실제 값은 .env(미추적)에 둔다.
# v1 DB(5432)와 분리된 전용 인스턴스(docker-compose.yml: saju-v2-db, 호스트 5433).
SAJU_V2_DATABASE_URL=postgresql://saju_v2:saju_v2@localhost:5433/saju_v2

# LLM 키(루트 ../.env에서 자동 로드됨 — backend/config/llm_config.json에서 모델·폴백 관리)
# GEMINI_API_KEY=...   # 메인(gemini-3-flash-preview)
# OPENAI_API_KEY=...   # 비상 폴백(gpt-5-mini)

# ── 위험 노출 활성화(r4.1.0 — 베타 적용 중) ──
# 실제 활성화 값은 루트 .env.risk(gitignore)에 있다 — dev.sh가 기동 시 source.
# pytest 격리를 위해 .env에는 RISK_* 값을 넣지 않는다.
# 중단: .env.risk 삭제 또는 RISK_ENGINE_MODE=off 후 재기동(byte 복귀).
# 점검: (set -a; . ../.env.risk; set +a) 후 python scripts/risk_canary_smoke.py

# ── 테스터 beta flag(전체 목록 — 신규 beta 기능은 반드시 여기에 등재한다) ──
# 실제 활성화 값은 루트 .env.beta(gitignore)에 있다 — dev.sh가 기동 시 source.
# .env가 아니라 별도 파일인 이유: 이 flag들은 모듈 import 시점 상수로 굳으므로,
# .env에 두면 개발자가 source한 셸에서 pytest를 돌릴 때 OFF 기준 회귀가 오염된다.
# 등재를 빠뜨리면 구현·배선·테스트가 끝난 기능이 조용히 영구 off로 남는다(2026-07-25 실제 발생).
# 전부 기본 false — 파일 부재 = beta 기능 전부 off(기존 출력 byte 유지).
# 런타임 확인: curl -s localhost:8000/health | jq .beta_flags
#
# SAJU_CAREER_TRANSITION_CHAT_ENABLED=false      # 이직/커리어 블록 — 내부 payload·감사만
# SAJU_CAREER_TRANSITION_CHAT_BETA_EXPOSE=false  #   └ 사용자 노출까지(위 flag와 둘 다 필요)
# SAJU_RELATIONSHIP_BETA_EXPOSE=false            # 관계 벡터 인사이트(채팅·리포트)
# SAJU_RELATIONSHIP_RISK_BETA_EXPOSE=false       # 관계 위험 dev beta(RISK_ENGINE_MODE=shadow 이상 필요)
# SAJU_DAILY_FORTUNE_PREGEN=0                    # 오늘의 운세 익일 선생성(23:50 KST) — 1이면 on
#
# beta 아님(값 고정·참고용):
# CAREER_SHADOW_REPOSITORY=postgres              # 커리어 shadow 원장 저장소. memory는 개발 전용이며
#                                                #   DB 오류 시 자동 fallback 하지 않는다(migration 016).
