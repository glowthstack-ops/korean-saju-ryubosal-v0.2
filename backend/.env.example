# saju_v2 백엔드 환경 변수 예시 — 실제 값은 .env(미추적)에 둔다.
# v1 DB(5432)와 분리된 전용 인스턴스(docker-compose.yml: saju-v2-db, 호스트 5433).
SAJU_V2_DATABASE_URL=postgresql://saju_v2:saju_v2@localhost:5433/saju_v2

# LLM 키(루트 ../.env에서 자동 로드됨 — backend/config/llm_config.json에서 모델·폴백 관리)
# GEMINI_API_KEY=...   # 메인(gemini-3-flash-preview)
# OPENAI_API_KEY=...   # 비상 폴백(gpt-5-mini)

# ── 위험 노출 활성화(r4.1.0 — 베타 적용 중) ──
# 실제 활성화 값은 루트 .env.risk(gitignore)에 있다 — dev.sh가 기동 시 source.
# pytest 격리를 위해 .env에는 RISK_* 값을 넣지 않는다.
# 중단: .env.risk 삭제 또는 RISK_ENGINE_MODE=off 후 재기동(byte 복귀).
# 점검: (set -a; . ../.env.risk; set +a) 후 python scripts/risk_canary_smoke.py
