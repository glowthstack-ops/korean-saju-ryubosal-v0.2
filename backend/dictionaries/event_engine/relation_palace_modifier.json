{
  "schema": "relation_palace_event_modifier.v1",
  "reviewed": false,
  "extends": [
    "transit_ten_god_event_branching.v1",
    "transit_ten_god_event_branching_addendum.v1",
    "twelve_life_stage_event_modifier.v1"
  ],
  "purpose": "운에서 원국 또는 운끼리 발생하는 합충형파해와 궁성 활성 정보를 이용해 십성 기반 이벤트 후보의 실제 사건화 여부와 생활 영역을 보정한다.",
  "core_principle": {
    "ten_god": "무슨 사건인가",
    "twelve_life_stage": "사건이 어느 단계인가",
    "relation": "사건이 어떻게 발동되는가",
    "palace": "어느 생활 영역에서 발생하는가",
    "yonggi": "좋게 발현되는가, 부담으로 발현되는가"
  },
  "calculation_scope": {
    "primary_relations": [
      "transit_to_natal",
      "daewoon_to_natal",
      "sewoon_to_natal",
      "wolwoon_to_natal",
      "ilwoon_to_natal"
    ],
    "secondary_relations": [
      "daewoon_to_sewoon",
      "sewoon_to_wolwoon",
      "wolwoon_to_ilwoon"
    ],
    "background_relations": [
      "natal_internal_relation"
    ],
    "rule": "원국 내부 합충형파해는 성향·구조로 보고, 운이 자극할 때 사건화한다."
  },
