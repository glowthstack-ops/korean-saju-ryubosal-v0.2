  "hap_subtype_rules": {
    "CHEONGAN_HAP": {
      "name": "천간합",
      "meaning": "표면적 역할·제안·인물·직책·외부 조건의 결합",
      "event_effect": [
        "visible_offer",
        "negotiation",
        "role_binding",
        "public_agreement"
      ],
      "score_multiplier": 1.0,
      "notes": "천간합은 겉으로 드러나는 제안, 직책, 관계, 계약 협의에 가깝다."
    },
    "YUKHAP": {
      "name": "육합",
      "meaning": "개별 글자 간의 밀착 결합",
      "event_effect": [
        "relationship_binding",
        "contract_document",
        "cooperation",
        "attachment"
      ],
      "score_multiplier": 1.05,
      "notes": "관계·계약·협력 신호로 좋지만, 합화 조건이 없으면 합반으로 묶일 수 있다."
    },
    "SAMHAP": {
      "name": "삼합",
      "meaning": "특정 오행·방향성으로 사건 흐름이 크게 모임",
      "event_effect": [
        "domain_formation",
        "large_flow",
        "grouped_event"
      ],
      "score_multiplier": 1.2,
      "notes": "완성 삼합은 사건 도메인을 강하게 만들고, 반합은 중간 강도로 본다."
    },
    "BANGHAP": {
      "name": "방합",
      "meaning": "계절·환경의 방향성이 모임",
      "event_effect": [
        "environmental_pressure",
        "collective_flow",
        "background_amplification"
      ],
      "score_multiplier": 1.15,
      "notes": "방합은 개인 의지보다 환경 전체의 방향성이 강해지는 신호로 본다."
    },
    "HAPHWA": {
      "name": "합화",
      "meaning": "합이 실제로 다른 오행성으로 변화",
      "event_effect": [
        "transformation",
        "role_conversion",
        "new_domain_creation"
      ],
      "score_multiplier": 1.25,
      "required_conditions": [
        "월령 또는 계절의 지원",
        "화하려는 오행의 세력 존재",
        "합을 방해하는 충·형이 약함",
        "천간 투출 또는 지지 기반이 있음"
      ],
      "notes": "합화가 성립하면 기존 십성 의미보다 변환된 오행·십성 의미를 우선한다."
    },
    "HAPBAN": {
      "name": "합반",
      "meaning": "합은 되었으나 화하지 못하고 서로 묶임",
      "event_effect": [
        "binding",
        "delay",
        "loss_of_function",
        "stuck_relation"
      ],
      "score_multiplier": 1.1,
      "notes": "계약·관계·직장·거처가 묶이지만 실제 변화가 지연될 수 있다."
    },
    "HAPGEO": {
      "name": "합거",
      "meaning": "합으로 인해 한쪽 글자의 기능이 사라지거나 약화됨",
      "event_effect": [
        "removal",
        "function_loss",
        "detachment"
      ],
      "score_multiplier": 1.15,
      "notes": "용신이 합거되면 손실, 기신이 합거되면 문제 제거로 볼 수 있다."
    },
    "HAPRAE": {
      "name": "합래",
      "meaning": "운의 글자가 원국으로 끌려와 사건 자극이 됨",
      "event_effect": [
        "incoming_event",
        "opportunity_arrival",
        "external_person_or_offer"
      ],
      "score_multiplier": 1.15,
      "notes": "좋은 글자가 합래하면 기회, 나쁜 글자가 합래하면 부담이나 얽힘으로 본다."
    }
  },
