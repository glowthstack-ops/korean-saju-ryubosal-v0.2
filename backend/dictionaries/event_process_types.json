{
  "schema": "event_process_types.v1",
  "version": "1.0.0",
  "reviewed": false,
  "purpose": "작용(합충·십성·신살)과 생활 사건 사이의 중간 층 '공통 사건 유형'. 사건 라벨(EventKey)·길흉은 여기서 확정하지 않는다. 엔진이 후보의 근거 코드·신호·유불리 밴드로 결정론 분류하고 LLM은 '어떤 종류의 문제/개선인지'로만 쓴다. 경쟁 발생≠탈락≠손실, 기회 유입≠성취≠유지를 분리한다(2026-09-18 전문가 참고 기준).",
  "match_rules": "reason_prefixes: 후보 reason_code startswith / signal_keywords: 동반 신호·해석 줄 부분일치 / event_keys: 사건 키 제한(비면 무관) / favorability: any|adverse(≤-0.2)|favorable(≥0.2). 셋 중 하나라도 맞으면 후보(favorability 조건은 AND). loss_is_conclusion=false: '손실' 유형은 다른 유형의 자동 결론이 아니다.",
  "stage_model": {
    "negative": {
      "발생": "awareness",
      "진행": "exploration·action",
      "결과": "decision",
      "후속 영향": "실행·실속·유지(상담 결론 단계)"
    },
    "positive": {
      "기회 발생": "awareness",
      "진행": "exploration·action",
      "실제 성취": "decision",
      "유지·후속 효과": "실행·실속·유지(상담 결론 단계)"
    },
    "note": "E4 타임라인 단계(awareness→exploration→action→decision)와 상담 결론 단계별 행동(기회/과정/결정/실행/실속·유지)에 대응. 이름만 다를 뿐 새 단계가 아니다."
  },
