# API 연결 방식.
# 기본값 = 상대경로 /api (비워 둠). 클라이언트가 /api/... 를 호출하면 next.config.mjs의 rewrite가
# SAJU_BACKEND_URL(기본 http://localhost:8000)로 프록시한다 → same-origin·CORS 불필요(권장).
NEXT_PUBLIC_API_BASE=

# 프록시 목적지(서버 사이드). 백엔드 포트가 다르면 여기만 바꾼다.
SAJU_BACKEND_URL=http://localhost:8000

# (옵션) 절대 URL로 직접 호출하려면 위 NEXT_PUBLIC_API_BASE에 http://localhost:8000 을 넣는다.
# 이 경우 백엔드 SAJU_CORS_ORIGINS에 프론트 origin을 등록해야 한다.
